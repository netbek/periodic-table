{
  "name": "@netbek/periodic-table",
  "version": "1.0.0",
  "description": "Periodic table with responsive layout",
  "repository": {
    "type": "git",
    "url": "git://github.com/netbek/periodic-table.git"
  },
  "author": {
    "name": "Hein Bekker",
    "email": "hein@netbek.co.za",
    "url": "https://www.netbek.co.za"
  },
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/netbek/periodic-table/issues"
  },
  "type": "module",
  "browserslist": [
    "chrome >= 93",
    "and_chr >= 93",
    "edge >= 93",
    "safari >= 15.4",
    "ios_saf >= 15.4",
    "firefox >= 92",
    "and_ff >= 92",
    "samsung >= 17",
    "opera >= 79"
  ],
  "files": [
    "src/css"
  ],
  "scripts": {
    "build:demo": "node scripts/build-demo.js",
    "build": "npm run clean && npm run build:demo",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "deploy": "node scripts/deploy.js",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "test": "echo test"
  },
  "devDependencies": {
    "autoprefixer": "10.6.2",
    "browserslist": "4.29.5",
    "chrys": "5.0.0",
    "esbuild": "0.28.2",
    "globby": "16.2.4",
    "js-yaml": "5.5.0",
    "normalize.css": "8.0.1",
    "npm-check-updates": "23.1.1",
    "nunjucks": "3.2.4",
    "oxlint": "1.90.0",
    "patch-package": "8.0.1",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "sass-embedded": "1.107.1"
  }
}
